    {
      "parameters": {
        "jsCode": "const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst b64 = buf.toString('base64');\nconst mime = $input.first().binary.data.mimeType || 'audio/mpeg';\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Ho_Chi_Minh' });\n\nconst prompt = `Bạn là chuyên viên tiếp nhận khiếu nại khách hàng.\nHãy nghe file audio và xác định đây có phải cuộc gọi khiếu nại không.\nTrả về DUY NHẤT một JSON, không giải thích thêm, gồm các khóa:\n- is_complaint: true hoặc false\n- title: tiêu đề ticket ngắn gọn dưới 100 ký tự bằng tiếng Việt\n- category: một trong \"giao hang\", \"san pham\", \"thanh toan\", \"thai do\", \"khac\"\n- priority: một trong \"low\", \"medium\", \"high\", \"urgent\"\n- escalate: true nếu khách đe dọa hủy đơn hoặc kiện, đòi gặp quản lý, hoặc vấn đề nghiêm trọng; ngược lại false\n- description: mô tả vấn đề và yêu cầu của khách trong 2-4 câu bằng tiếng Việt\nHôm nay là ${today}.\nNếu không phải khiếu nại hoặc audio không có lời thoại, đặt is_complaint = false và description ghi lý do ngắn.`;\n\nreturn [{\n  json: {\n    requestBody: {\n      contents: [{ parts: [\n        { inline_data: { mime_type: mime, data: b64 } },\n        { text: prompt },\n      ]}],\n      generationConfig: { responseMimeType: 'application/json' },\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "fada74d1-7ddf-4094-a7fc-54cdfad11a1c",
