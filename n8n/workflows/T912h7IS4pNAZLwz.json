    {
      "parameters": {
        "jsCode": "const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst b64 = buf.toString('base64');\nconst mime = $input.first().binary.data.mimeType || 'audio/mpeg';\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Ho_Chi_Minh' });\n\nconst prompt = `Bạn là chuyên viên kiểm định chất lượng cuộc gọi chăm sóc khách hàng.\nHãy nghe file audio và chấm điểm nhân viên theo 5 tiêu chí, mỗi tiêu chí từ 0 đến 20 điểm.\nTrả về DUY NHẤT một JSON, không giải thích thêm, gồm các khóa:\n- score_total: tổng điểm (số nguyên 0-100)\n- criteria: mảng 5 object {name, score, comment} theo thứ tự: \"Chào hỏi\", \"Thấu cảm\", \"Giải quyết vấn đề\", \"Tuân thủ kịch bản\", \"Chốt và cảm ơn\"\n- forbidden_words_found: mảng các từ hoặc câu không phù hợp nhân viên đã nói (rỗng nếu không có)\n- customer_sentiment: \"positive\", \"neutral\" hoặc \"negative\"\n- summary: nhận xét 2-3 câu bằng tiếng Việt\nHôm nay là ${today}.\nNếu audio không có lời thoại của nhân viên và khách, đặt score_total = 0, criteria là mảng rỗng và summary ghi \"Không có lời thoại\".`;\n\nreturn [{\n  json: {\n    requestBody: {\n      contents: [{ parts: [\n        { inline_data: { mime_type: mime, data: b64 } },\n        { text: prompt },\n      ]}],\n      generationConfig: { responseMimeType: 'application/json' },\n    },\n  },\n}];"
      },
