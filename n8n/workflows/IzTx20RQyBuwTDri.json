      "name": "Download Audio"
    },
    {
      "parameters": {
        "jsCode": "const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst b64 = buf.toString('base64');\nconst hook = $('Webhook').first().json.body;\nconst mime = $input.first().binary.data.mimeType || 'audio/mpeg';\n\nconst prompt = `Bạn là trợ lý phân tích cuộc gọi chăm sóc khách hàng.\nHãy nghe file audio và trả về DUY NHẤT một JSON với các khóa:\n- transcript: toàn bộ lời thoại (ghi rõ người nói nếu phân biệt được)\n- language: mã ngôn ngữ, ví dụ \"vi\" hoặc \"en\"\n- summary: tóm tắt 2-4 câu bằng tiếng Việt\n- sentiment: \"positive\", \"neutral\" hoặc \"negative\"\n- keywords: mảng 3-6 từ khóa\n- action_items: mảng các object {task, owner, due_date}, due_date dạng YYYY-MM-DD hoặc null\nHôm nay là ${new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Ho_Chi_Minh' })}. Nếu audio không có lời thoại, để transcript rỗng và summary ghi \"Không có lời thoại\".`;\n\nreturn [{\n  json: {\n    requestBody: {\n      contents: [{ parts: [\n        { inline_data: { mime_type: mime, data: b64 } },\n        { text: prompt },\n      ]}],\n      generationConfig: { responseMimeType: 'application/json' },\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "d48da132-af71-4a5c-a633-b72989a93314",
      "name": "Build Request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.requestBody }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        0
      ],
      "id": "8807f8b2-b3a4-4f58-a56a-75499d745d18",
      "name": "Gemini",
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "oBkVroe3yfT0Plx0",
          "name": "Header Auth account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates?.[0]?.content?.parts?.[0]?.text ?? '{}';\nlet data;\ntry {\n  data = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  throw new Error('Gemini trả JSON không hợp lệ: ' + raw.slice(0, 200));\n}\nif (Array.isArray(data)) data = data[0] ?? {};\nconst hook = $('Webhook').first().json.body;\nreturn [{ json: { callbackUrl: hook.callbackUrl, payload: data } }];"
      },
      "type": "n8n-nodes-base.code",
