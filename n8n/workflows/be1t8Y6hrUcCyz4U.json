    {
      "parameters": {
        "jsCode": "const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst b64 = buf.toString('base64');\nconst mime = $input.first().binary.data.mimeType || 'audio/mpeg';\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Ho_Chi_Minh' });\n\nconst prompt = `Bạn là chuyên viên đánh giá khách hàng tiềm năng (lead) từ cuộc gọi bán hàng.\nHãy nghe file audio và chấm điểm khách hàng dựa trên 4 yếu tố: ý định mua, ngân sách, thời gian quyết định, quyền quyết định.\nTrả về DUY NHẤT một JSON, không giải thích thêm, gồm các khóa:\n- name: tên khách nếu nghe được, nếu không thì null\n- phone: số điện thoại nếu khách nêu, nếu không thì null\n- interest: khách quan tâm sản phẩm hoặc dịch vụ gì (1-2 câu tiếng Việt)\n- score: điểm tiềm năng từ 0 đến 100 (số nguyên)\n- notes: bước tiếp theo nên làm với khách này (1-2 câu tiếng Việt)\nHôm nay là ${today}.\nNếu audio không có lời thoại, đặt score = 0 và notes ghi \"Không có lời thoại\".`;\n\nreturn [{\n  json: {\n    requestBody: {\n      contents: [{ parts: [\n        { inline_data: { mime_type: mime, data: b64 } },\n        { text: prompt },\n      ]}],\n      generationConfig: { responseMimeType: 'application/json' },\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "5c96e2b9-2cac-4783-bf70-2ab5fc12b452",
      "name": "Build Request"
    },
